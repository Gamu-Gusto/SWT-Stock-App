# ---------------------------------------------------------------------------
# Super Wheels and Tyres – Stock Management System
# Copy to .env and fill in. NEVER commit .env or place it inside public_html.
# ---------------------------------------------------------------------------

APP_NAME="Super Wheels Stock"
# production on the live server, local for development
APP_ENV=production
# Generate with: php artisan key:generate   (keep it secret; changing it logs everyone out)
APP_KEY=
# MUST be false in production – true exposes server paths and configuration in error pages
APP_DEBUG=false
APP_URL=https://stock.superwheeltyres.co.za
APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_MAINTENANCE_DRIVER=file

# One-time browser installer (/setup) for hosting without SSH. Set a long random value,
# open https://stock.superwheeltyres.co.za/setup, create the owner, then REMOVE this line.
SETUP_TOKEN=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# MySQL 8+ or MariaDB 10.6+ (DirectAdmin → MySQL Management)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions are stored in the database. Idle sessions expire after this many minutes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=stock.superwheeltyres.co.za
# HTTPS only cookies (keep true in production)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Same-origin SPA – the app's own domain
SANCTUM_STATEFUL_DOMAINS=stock.superwheeltyres.co.za

# No Redis required
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Optional: e-mail for password-reset links and stock alerts.
# Use the DirectAdmin mailbox SMTP details. Leave MAIL_MAILER=log to disable e-mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.superwheeltyres.co.za
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="stock@superwheeltyres.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Set only if the server sits behind a proxy / load balancer (e.g. Cloudflare): TRUSTED_PROXIES=*
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
